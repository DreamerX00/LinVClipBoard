// Windows resource file for LinVClipBoard
// Provides version info and file description to Windows Explorer

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     3,0,0,0
PRODUCTVERSION  3,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0" // en-US, Unicode
        BEGIN
            VALUE "CompanyName",      "LinVClipBoard Contributors"
            VALUE "FileDescription",  "LinVClipBoard Clipboard Manager"
            VALUE "FileVersion",      "3.0.0.0"
            VALUE "InternalName",     "LinVClipBoard"
            VALUE "LegalCopyright",   "Copyright (c) 2025-2026 LinVClipBoard Contributors. MIT License."
            VALUE "OriginalFilename", "LinVClipBoard.exe"
            VALUE "ProductName",      "LinVClipBoard"
            VALUE "ProductVersion",   "3.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
