{
    "productName": "LinVClipBoard",
    "version": "3.2.1",
    "identifier": "com.linvclipboard.app",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:1420",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "title": "LinVClipBoard",
                "width": 420,
                "height": 520,
                "resizable": true,
                "minWidth": 320,
                "minHeight": 400,
                "maxWidth": 1800,
                "maxHeight": 900,
                "decorations": false,
                "transparent": true,
                "alwaysOnTop": true,
                "visible": true,
                "center": true,
                "skipTaskbar": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost https://static.klipy.com data:; connect-src 'self' https://api.klipy.com https://api.github.com https://github.com https://objects.githubusercontent.com; script-src 'self'; font-src 'self' data:"
        }
    },
    "bundle": {
        "active": true,
        "icon": [
            "icons/32x32.png",
            "icons/icon.png",
            "icons/icon.ico"
        ]
    },
    "plugins": {
        "updater": {
            "pubkey": "PLEASE_REPLACE_WITH_GENERATED_PUBKEY",
            "endpoints": [
                "https://github.com/DreamerX00/LinVClipBoard/releases/latest/download/update-windows-x86_64.json"
            ],
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
