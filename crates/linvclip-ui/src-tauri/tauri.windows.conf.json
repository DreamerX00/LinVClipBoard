{
    "bundle": {
        "targets": [
            "nsis"
        ],
        "windows": {
            "webviewInstallMode": {
                "type": "downloadBootstrapper"
            },
            "nsis": {
                "installMode": "currentUser",
                "languages": [
                    "English"
                ],
                "displayLanguageSelector": false,
                "installerHooks": "../../../windows/hooks/installer.nsh"
            }
        },
        "resources": {
            "resources/clipd.exe": ".",
            "resources/clipctl.exe": "."
        },
        "createUpdaterArtifacts": true
    }
}
